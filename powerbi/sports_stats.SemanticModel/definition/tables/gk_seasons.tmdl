	partition gk_seasons = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "gk_seasons.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"row_id", Int64.Type}, {"player_name", type text}, {"team_title", type text}, {"league", type text}, {"season", type text}, {"year", Int64.Type}, {"ga", Int64.Type}, {"xga", type number}, {"ga_xga", type number}, {"goals_prevented", type number}, {"xga_90", type number}, {"prior_ratio", type number}, {"elite_group", type text}}, "en-US")
				in
				    Typed

