		sourceColumn: season

	column year
		dataType: int64
		formatString: 0
		lineageTag: 642fde16-bdd7-46ed-8603-ee04fb56d505
		summarizeBy: none
		sourceColumn: year

	column ga
		dataType: int64
		formatString: 0
		lineageTag: 926232ff-c91c-4b58-a7e7-55df66a1c208
