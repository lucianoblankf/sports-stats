table gk_seasons
	lineageTag: efeb4fda-a3d9-4135-b0f2-09b399d4de8f

	measure Team-seasons = COUNTROWS(gk_seasons)
		formatString: #,0
		lineageTag: e661e9d3-ae84-48d1-b9d1-13a2048312d6

	measure 'Mean ga/xGA' = AVERAGE(gk_seasons[ga_xga])
		formatString: 0.000
		lineageTag: 23e6f8d3-368c-4915-99bf-dfb003c03558

	measure 'Elite mean ga/xGA' = CALCULATE(AVERAGE(gk_seasons[ga_xga]), gk_seasons[elite_group] = "Elite (out of sample)")
		formatString: 0.000
		lineageTag: cb2919d2-edd5-43e3-baa8-cf3b41163483

	measure 'Other mean ga/xGA' = CALCULATE(AVERAGE(gk_seasons[ga_xga]), gk_seasons[elite_group] = "Other")
		formatString: 0.000
		lineageTag: 0837c67a-de71-4465-bca6-3c6b8632a709

	column row_id
		dataType: int64
		formatString: 0
		lineageTag: 1a185aea-5c12-46b7-8759-17a8b4d356c2
		summarizeBy: none
		sourceColumn: row_id

	column player_name
		dataType: string
