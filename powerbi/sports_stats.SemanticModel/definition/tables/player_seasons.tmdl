table player_seasons
	lineageTag: 700a0a44-6a71-46bb-9ea8-b22c97c8f9b3

	measure 'Player seasons' = COUNTROWS(player_seasons)
		formatString: #,0
		lineageTag: 5581a8c2-a3c2-456c-b1a9-18e08cb96c76

	measure 'Goals/xG (total)' = DIVIDE(SUM(player_seasons[goals]), SUM(player_seasons[xg]))
		formatString: 0.000
		lineageTag: a261efe0-454b-4bcb-b398-124cc9962f2e

	measure 'Mean goals/xG' = AVERAGE(player_seasons[goals_xg])
		formatString: 0.000
		lineageTag: f624000b-e1d4-4659-9320-8cd2d0f9416c

	measure 'Mean xG per 90' = AVERAGE(player_seasons[xg_90])
