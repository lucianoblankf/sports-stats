	partition pca_variance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "pca_variance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"component", type text}, {"eigenvalue", type number}, {"variance_pct", type number}, {"cumulative_pct", type number}}, "en-US")
				in
				    Typed

