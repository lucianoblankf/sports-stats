table pca_variance
	lineageTag: 70781c32-342d-4e65-8535-fea650c2a755

	column component
		dataType: string
		lineageTag: b50dda78-51e9-4ffd-8586-b2c57e1a92fe
		summarizeBy: none
		sourceColumn: component

	column eigenvalue
		dataType: double
		lineageTag: a5b62ac9-854d-4aa9-a5ff-6f8aa946ac50
		summarizeBy: sum
		sourceColumn: eigenvalue

	column variance_pct
		dataType: double
