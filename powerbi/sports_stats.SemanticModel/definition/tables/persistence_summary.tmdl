	partition persistence_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "persistence_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"variable", type text}, {"n_pairs", Int64.Type}, {"pearson_r", type number}, {"r_ci_low", type number}, {"r_ci_high", type number}, {"spearman_rho", type number}, {"slope", type number}, {"slope_se", type number}}, "en-US")
				in
				    Typed

