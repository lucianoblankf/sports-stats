table persistence_summary
	lineageTag: f7831676-2870-45d7-acad-a4e44734f240

	measure 'r goals/xG' = CALCULATE(MAX(persistence_summary[pearson_r]), persistence_summary[variable] = "goals_xg")
		formatString: 0.00
		lineageTag: 28c1247e-dc71-4dc0-a07b-b0f0793baf5e

	measure 'r xG per 90' = CALCULATE(MAX(persistence_summary[pearson_r]), persistence_summary[variable] = "xg_90")
		formatString: 0.00
		lineageTag: d22c8993-87c2-4c75-b035-9f611641c3c2

	column variable
		dataType: string
		lineageTag: f177f28f-a194-4452-bd90-0baf7aefea7f
		summarizeBy: none
		sourceColumn: variable

	column n_pairs
		dataType: int64
		formatString: 0
		lineageTag: 9e256271-b1e2-4a34-a3b6-57a410865a3f
